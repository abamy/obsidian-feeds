{
	"name": "obsidian-feeds",
	"version": "0.1.0",
	"description": "Feed layout for Obsidian Bases with inline properties and editable content.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"feed",
		"bases",
		"properties"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "24.6.1",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.10",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	}
}
